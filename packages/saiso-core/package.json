{
  "name": "@saiso/core",
  "version": "1.0.0-rc5",
  "description": "Core utilities and configuration management for SAISO - EVM-agnostic blockchain agent toolkit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0",
    "semver": "^7.6.0",
    "telegram-markdown-v2": "^0.0.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/semver": "^7.5.8",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "README.md",
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "saiso",
    "blockchain",
    "evm",
    "agent",
    "configuration",
    "utilities"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BHIIKTOR/saiso.git",
    "directory": "packages/saiso-core"
  },
  "homepage": "https://github.com/BHIIKTOR/saiso#readme",
  "bugs": {
    "url": "https://github.com/BHIIKTOR/saiso/issues"
  },
  "readme": "# @saiso/core\n\nCore runtime, configuration, MCP orchestration, payment, identity, trust, service blueprint, and utility modules used by SAISO projects and the `@saiso/cli` package.\n\n## Install\n\n```bash\nnpm install @saiso/core@rc\n```\n\n## Repository\n\nhttps://github.com/BHIIKTOR/saiso\n",
  "readmeFilename": "README.md"
}
