{
  "manifestVersion": 1,
  "id": "heretic-saiso",
  "version": "1.0.0-rc3",
  "pluginApiVersion": "1.0.0",
  "saisoRange": "^1.0.0-rc3",
  "entry": "dist/plugin-entry.bundle.js",
  "capabilities": [
    "heretic-daemon",
    "workspace-session-bootstrap",
    "runtime-provider-model",
