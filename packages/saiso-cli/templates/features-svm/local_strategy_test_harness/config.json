{
  "name": "local_strategy_test_harness",
  "displayName": "Local Strategy Test Harness (SVM Adapter)",
  "description": "Run deterministic local strategy scenarios (SVM-specific adapter)",
  "version": "1.0.0",
  "category": "execution",
  "serverType": "svm",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/localStrategyTestHarness.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/localStrategyTestHarness.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/local_strategy_test_harness.md"
    }
  ],
  "integration": {
    "actions": ["localStrategyTestHarnessAction"],
    "imports": [
      "import { localStrategyTestHarnessAction } from './actions/localStrategyTestHarness.js';"
    ]
  },
  "environment": {
    "required": [],
    "optional": [
      "CHAIN_ID",
      "RPC_URL"
    ]
  },
  "features": {
    "serverSpecific": true,
    "adapter": "svm"
  },
  "examples": [
    "Run local_strategy_test_harness with SVM adapter"
  ]
}
