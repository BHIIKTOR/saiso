import { describe, it, expect } from 'bun:test';

describe('{{agentName}} EVM Agent', () => {
  it('initializes with EVM runtime defaults', async () => {
    const env = process.env.SAISO_TEST_ENV || '{{environment}}';
    const rpcUrl = process.env.RPC_URL || '{{rpcUrl}}';

    expect(['testnet', 'devnet', 'mainnet'].includes(env)).toBe(true);
    expect(rpcUrl.startsWith('http://') || rpcUrl.startsWith('https://')).toBe(true);
  });

  it('supports chain id and gas-related config surfaces', async () => {
    const chainId = process.env.CHAIN_ID || '{{chainId}}';
    expect(Number.parseInt(chainId, 10)).toBeGreaterThan(0);
  });

  it('preserves deterministic EVM feature contract checks', async () => {
    const capabilities = ['gas-estimation', 'tx-simulation', 'token-transfer'];
    expect(capabilities).toContain('gas-estimation');
    expect(capabilities).toContain('tx-simulation');
  });
});
