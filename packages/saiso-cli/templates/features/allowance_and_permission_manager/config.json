{
  "name": "allowance_and_permission_manager",
  "displayName": "Allowance and Permission Manager",
  "description": "Manage approvals, allowances, and permission safety",
  "version": "1.0.0",
  "category": "security",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/allowancePermissionManager.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/allowancePermissionManager.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/allowance_and_permission_manager.md"
    }
  ],
  "integration": {
    "actions": ["allowancePermissionManagerAction"],
    "imports": [
      "import { allowancePermissionManagerAction } from './actions/allowancePermissionManager.js';"
    ]
  },
  "environment": {
    "required": [],
    "optional": [
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ]
  },
  "features": {
    "workflowParity": true,
    "chainAgnostic": true,
    "productionScaffold": true
  },
  "examples": [
    "Run allowance_and_permission_manager in dry-run mode",
    "Execute allowance_and_permission_manager for EVM and SVM"
  ]
}
