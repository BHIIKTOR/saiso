{
  "name": "scheduler_and_workflow_runner",
  "displayName": "Scheduler and Workflow Runner",
  "description": "Schedule and execute idempotent multi-step workflows",
  "version": "1.0.0",
  "category": "automation",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/schedulerWorkflowRunner.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/schedulerWorkflowRunner.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/scheduler_and_workflow_runner.md"
    }
  ],
  "integration": {
    "actions": ["schedulerWorkflowRunnerAction"],
    "imports": [
      "import { schedulerWorkflowRunnerAction } from './actions/schedulerWorkflowRunner.js';"
    ]
  },
  "environment": {
    "required": [],
    "optional": [
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ]
  },
  "features": {
    "workflowParity": true,
    "chainAgnostic": true,
    "productionScaffold": true
  },
  "examples": [
    "Run scheduler_and_workflow_runner in dry-run mode",
    "Execute scheduler_and_workflow_runner for EVM and SVM"
  ]
}
