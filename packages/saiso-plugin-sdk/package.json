{
  "name": "@saiso/plugin-sdk",
  "version": "1.0.0-rc2",
  "description": "Plugin SDK contracts for SAISO plugin authors",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
