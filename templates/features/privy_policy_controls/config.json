{
  "name": "privy_policy_controls",
  "displayName": "Privy Policy Controls",
  "description": "Manage Privy policy and key-quorum controls",
  "version": "1.0.0",
  "category": "privy",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/privyPolicyControls.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/privyPolicyControls.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/privy_policy_controls.md"
    }
  ],
  "integration": {
    "actions": [
      "privyPolicyControlsAction"
    ],
    "imports": [
      "import { privyPolicyControlsAction } from './actions/privyPolicyControls.js';"
    ]
  },
  "environment": {
    "required": [
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ],
    "optional": [
      "PRIVY_BASE_URL",
      "PRIVY_REQUEST_TIMEOUT_MS",
      "PRIVY_REQUEST_EXPIRY_MS",
      "PRIVY_RETRY_MAX_ATTEMPTS",
      "PRIVY_RETRY_BASE_DELAY_MS",
      "PRIVY_DEFAULT_WALLET_ID"
    ]
  },
  "features": {
    "workflowParity": true,
    "chainAgnostic": true,
    "privyBacked": true
  },
  "examples": [
    "Run privy_policy_controls for an EVM wallet",
    "Run privy_policy_controls for an SVM wallet"
  ],
  "featureDependencies": [
    "privy_client_base"
  ]
}
