{
  "name": "cross_chain_intent_router",
  "displayName": "Cross-Chain Intent Router",
  "description": "Route intent-driven workflows across chains",
  "version": "1.0.0",
  "category": "routing",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/crossChainIntentRouter.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/crossChainIntentRouter.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/cross_chain_intent_router.md"
    }
  ],
  "integration": {
    "actions": ["crossChainIntentRouterAction"],
    "imports": [
      "import { crossChainIntentRouterAction } from './actions/crossChainIntentRouter.js';"
    ]
  },
  "environment": {
    "required": [],
    "optional": [
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ]
  },
  "features": {
    "workflowParity": true,
    "chainAgnostic": true,
    "productionScaffold": true
  },
  "examples": [
    "Run cross_chain_intent_router in dry-run mode",
    "Execute cross_chain_intent_router for EVM and SVM"
  ]
}
