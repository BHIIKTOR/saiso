{
  "name": "tx_lifecycle_manager",
  "displayName": "Transaction Lifecycle Manager (SVM Adapter)",
  "description": "Track, classify, and manage transaction lifecycle states (SVM-specific adapter)",
  "version": "1.0.0",
  "category": "execution",
  "serverType": "svm",
  "dependencies": {},
  "files": [
    {
      "source": "action.ts",
      "destination": "src/actions/txLifecycleManager.ts"
    },
    {
      "source": "test.ts",
      "destination": "src/tests/txLifecycleManager.test.ts"
    },
    {
      "source": "README.md",
      "destination": "docs/features/tx_lifecycle_manager.md"
    }
  ],
  "integration": {
    "actions": ["txLifecycleManagerAction"],
    "imports": [
      "import { txLifecycleManagerAction } from './actions/txLifecycleManager.js';"
    ]
  },
  "environment": {
    "required": [
      "RPC_URL"
    ],
    "optional": [
      "CHAIN_ID"
    ]
  },
  "features": {
    "serverSpecific": true,
    "adapter": "svm"
  },
  "examples": [
    "Run tx_lifecycle_manager with SVM adapter"
  ]
}
